+static void v4l2_dmabuf_sync(V4L2Buffer *avbuf, uint64_t flags)
+{
+    for (int i = 0; i < avbuf->num_planes; i++) {
+        struct dma_buf_sync sync = { .flags = flags };
+        if (avbuf->plane_info[i].dmabuf_fd >= 0)
+            ioctl(avbuf->plane_info[i].dmabuf_fd, DMA_BUF_IOCTL_SYNC, &sync);
+    }
+}
+
+void ff_v4l2_buffer_cpu_access(V4L2Buffer *avbuf, int start, int write)
+{
+    if (buf_to_m2mctx(avbuf)->use_dmabuf)
+        v4l2_dmabuf_sync(avbuf, (start ? DMA_BUF_SYNC_START : DMA_BUF_SYNC_END) |
+                                (write ? DMA_BUF_SYNC_WRITE : DMA_BUF_SYNC_READ));
+}
+
+/* Fallback when the DMA heaps are not reachable (Firefox's media sandbox only
+ * allows /dev/dri and /dev/video*): a linear GBM buffer object from the DRM
+ * render node, exported as a dma-buf. libgbm is loaded at runtime.
+ */
+struct gbm_device;
+struct gbm_bo;
+static int v4l2_gbm_alloc(size_t len)
+{
+    static void *lib;
+    static struct gbm_device *dev;
+    static struct gbm_device *(*create_device)(int);
+    static struct gbm_bo *(*bo_create)(struct gbm_device *, uint32_t, uint32_t, uint32_t, uint32_t);
+    static int (*bo_get_fd)(struct gbm_bo *);
+    static void (*bo_destroy)(struct gbm_bo *);
+    struct gbm_bo *bo;
+    uint32_t w = 4096, h;
+    int fd;
+
+    if (!dev) {
+        int drm = open("/dev/dri/renderD128", O_RDWR);
+        if (drm < 0)
+            return -1;
+        lib = dlopen("libgbm.so.1", RTLD_NOW | RTLD_LOCAL);
+        if (!lib) { close(drm); return -1; }
+        create_device = dlsym(lib, "gbm_create_device");
+        bo_create     = dlsym(lib, "gbm_bo_create");
+        bo_get_fd     = dlsym(lib, "gbm_bo_get_fd");
+        bo_destroy    = dlsym(lib, "gbm_bo_destroy");
+        if (!create_device || !bo_create || !bo_get_fd || !bo_destroy ||
+            !(dev = create_device(drm))) {
+            close(drm);
+            return -1;
+        }
+    }
+    h = (len + w - 1) / w;
+    /* GBM_FORMAT_R8, GBM_BO_USE_LINEAR | GBM_BO_USE_RENDERING */
+    bo = bo_create(dev, w, h, MKTAG('R', '8', ' ', ' '), (1 << 4) | (1 << 2));
+    if (!bo)
+        return -1;
+    fd = bo_get_fd(bo);
+    bo_destroy(bo);   /* the dma-buf keeps the memory */
+    return fd;
+}
+
+static int v4l2_dmabuf_alloc(size_t len)
+{
+    static const char *heaps[] = { "/dev/dma_heap/system", "/dev/dma_heap/qcom,system" };
+    if (getenv("FFMPEG_V4L2_GBM"))
+        return v4l2_gbm_alloc(len);
+    for (int i = 0; i < FF_ARRAY_ELEMS(heaps); i++) {
+        struct dma_heap_allocation_data alloc = {
+            .len = len, .fd_flags = O_RDWR,
+        };
+        int heap = open(heaps[i], O_RDWR);
+        if (heap < 0)
+            continue;
+        if (!ioctl(heap, DMA_HEAP_IOCTL_ALLOC, &alloc)) {
+            close(heap);
+            return alloc.fd;
+        }
+        close(heap);
+    }
+    return v4l2_gbm_alloc(len);
+}
+
+static int v4l2_buffer_initialize_dmabuf(V4L2Buffer *avbuf, int index)
+{
+    V4L2Context *ctx = avbuf->context;
+    int mp = V4L2_TYPE_IS_MULTIPLANAR(ctx->type);
+
+    avbuf->buf.memory = V4L2_MEMORY_DMABUF;
+    avbuf->buf.type   = ctx->type;
+    avbuf->buf.index  = index;
+    avbuf->num_planes = mp ? ctx->format.fmt.pix_mp.num_planes : 1;
+
+    for (int i = 0; i < avbuf->num_planes; i++) {
+        size_t len = mp ? ctx->format.fmt.pix_mp.plane_fmt[i].sizeimage :
+                          ctx->format.fmt.pix.sizeimage;
+        int fd = v4l2_dmabuf_alloc(len);
+        if (fd < 0)
+            return AVERROR(ENOMEM);
+        avbuf->plane_info[i].dmabuf_fd    = fd;
+        avbuf->plane_info[i].length       = len;
+        avbuf->plane_info[i].bytesperline = mp ? ctx->format.fmt.pix_mp.plane_fmt[i].bytesperline :
+                                                 ctx->format.fmt.pix.bytesperline;
+        avbuf->plane_info[i].mm_addr = mmap(NULL, len, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+        if (avbuf->plane_info[i].mm_addr == MAP_FAILED) {
+            avbuf->plane_info[i].mm_addr = NULL;
+            return AVERROR(ENOMEM);
+        }
+        if (mp) {
+            avbuf->planes[i].m.fd   = fd;
+            avbuf->planes[i].length = len;
+        } else {
+            avbuf->buf.m.fd   = fd;
+            avbuf->buf.length = len;
+        }
+    }
+    if (mp) {
+        avbuf->buf.m.planes = avbuf->planes;
+        avbuf->buf.length   = avbuf->num_planes;
+    }
+
+    avbuf->status = V4L2BUF_AVAILABLE;
+
+    if (V4L2_TYPE_IS_OUTPUT(ctx->type))
+        return 0;
+
+    return ff_v4l2_buffer_enqueue(avbuf);
+}
+
 int ff_v4l2_buffer_initialize(V4L2Buffer* avbuf, int index)
 {
     V4L2Context *ctx = avbuf->context;
     int ret, i;
 
+    for (i = 0; i < VIDEO_MAX_PLANES; i++)
+        avbuf->plane_info[i].dmabuf_fd = -1;
+    if (buf_to_m2mctx(avbuf)->use_dmabuf)
+        return v4l2_buffer_initialize_dmabuf(avbuf, index);
+
     avbuf->buf.memory = V4L2_MEMORY_MMAP;
     avbuf->buf.type = ctx->type;
     avbuf->buf.index = index;
@@ -588,6 +773,20 @@ int ff_v4l2_buffer_enqueue(V4L2Buffer* avbuf)
 
     avbuf->buf.flags = avbuf->flags;
 
+    if (buf_to_m2mctx(avbuf)->use_dmabuf) {
+        /* CPU is done with the frame (capture) / packet (output) */
+        ff_v4l2_buffer_cpu_access(avbuf, 0, V4L2_TYPE_IS_OUTPUT(avbuf->context->type));
+        for (int i = 0; i < avbuf->num_planes; i++) {
+            if (V4L2_TYPE_IS_MULTIPLANAR(avbuf->context->type)) {
+                avbuf->planes[i].m.fd   = avbuf->plane_info[i].dmabuf_fd;
+                avbuf->planes[i].length = avbuf->plane_info[i].length;
+            } else {
+                avbuf->buf.m.fd   = avbuf->plane_info[i].dmabuf_fd;
+                avbuf->buf.length = avbuf->plane_info[i].length;
+            }
+        }
+    }
+
     ret = ioctl(buf_to_m2mctx(avbuf)->fd, VIDIOC_QBUF, &avbuf->buf);
     if (ret < 0)
         return AVERROR(errno);

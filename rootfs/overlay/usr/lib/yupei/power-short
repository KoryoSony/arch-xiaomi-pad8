#!/bin/sh
# Native GNOME: power key tap (from yupei-powerkey). $1 = panel state before
# the press. Panel was on -> lock and switch it off; was off -> the press
# already woke it (mutter wakes on any key), make sure it stays on.
. /usr/lib/yupei/screen-power
case $1 in
    off) panel_power on ;;
    *)   lock_and_blank ;;
esac

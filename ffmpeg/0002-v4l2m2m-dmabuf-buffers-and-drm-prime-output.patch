+static int v4l2_buffer_buf_to_drmframe(AVFrame *frame, V4L2Buffer *avbuf)
+{
+    V4L2Context *ctx = avbuf->context;
+    AVDRMFrameDescriptor *desc;
+    int ret, mp = V4L2_TYPE_IS_MULTIPLANAR(ctx->type);
+    int bpl = avbuf->plane_info[0].bytesperline;
+    int h = mp ? ctx->format.fmt.pix_mp.height : ctx->format.fmt.pix.height;
+
+    /* keeps the V4L2 buffer out of the driver until the frame is released */
+    ret = v4l2_buf_to_bufref(avbuf, 0, &frame->buf[0]);
+    if (ret)
+        return ret;
+    desc = av_mallocz(sizeof(*desc));
+    if (!desc)
+        return AVERROR(ENOMEM);
+    frame->buf[1] = av_buffer_create((uint8_t *)desc, sizeof(*desc), av_buffer_default_free, NULL, 0);
+    if (!frame->buf[1]) {
+        av_free(desc);
+        return AVERROR(ENOMEM);
+    }
+
+    desc->nb_objects = avbuf->num_planes;
+    for (int i = 0; i < avbuf->num_planes; i++) {
+        desc->objects[i].fd              = avbuf->plane_info[i].dmabuf_fd;
+        desc->objects[i].size            = avbuf->plane_info[i].length;
+        desc->objects[i].format_modifier = 0; /* DRM_FORMAT_MOD_LINEAR */
+    }
+    desc->nb_layers = 1;
+    desc->layers[0].format    = MKTAG('N', 'V', '1', '2'); /* DRM_FORMAT_NV12 */
+    desc->layers[0].nb_planes = 2;
+    desc->layers[0].planes[0].object_index = 0;
+    desc->layers[0].planes[0].offset       = 0;
+    desc->layers[0].planes[0].pitch        = bpl;
+    /* chroma follows luma in the same buffer, or is the second object */
+    desc->layers[0].planes[1].object_index = avbuf->num_planes > 1 ? 1 : 0;
+    desc->layers[0].planes[1].offset       = avbuf->num_planes > 1 ? 0 : (ptrdiff_t)bpl * h;
+    desc->layers[0].planes[1].pitch        = avbuf->num_planes > 1 ? avbuf->plane_info[1].bytesperline : bpl;
+
+    frame->data[0] = (uint8_t *)desc;
+    frame->format  = AV_PIX_FMT_DRM_PRIME;
+    return 0;
+}

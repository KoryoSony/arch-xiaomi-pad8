#!/bin/sh
# Native GNOME: power key tap. Locked + blanked -> wake to the lock screen;
# otherwise lock (GNOME blanks the screen after locking).
S="--session --dest org.gnome.ScreenSaver --object-path /org/gnome/ScreenSaver"
case $(gdbus call $S --method org.gnome.ScreenSaver.GetActive 2>/dev/null) in
    *true*) gdbus call $S --method org.gnome.ScreenSaver.SetActive false >/dev/null ;;
    *)      gdbus call $S --method org.gnome.ScreenSaver.Lock >/dev/null ;;
esac

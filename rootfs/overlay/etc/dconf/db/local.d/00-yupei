# GNOME defaults for the Xiaomi Pad 8.
# 3200x2136 on an 11" panel: 2x scaling.
[org/gnome/desktop/interface]
scaling-factor=uint32 2

[org/gnome/desktop/a11y/applications]
screen-keyboard-enabled=true

# Power key is handled by yupei-powerkey (tap = lock, hold = power dialog).
[org/gnome/settings-daemon/plugins/power]
power-button-action='nothing'
# Suspend doesn't work on this kernel (the screen-off idle state is used).
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'

# Flashlight, auto brightness and temperature quick settings.
[org/gnome/shell]
enabled-extensions=['xiaomi-pad8@yupei']

# No USBGuard on this system.
[org/gnome/desktop/privacy]
usb-protection=false

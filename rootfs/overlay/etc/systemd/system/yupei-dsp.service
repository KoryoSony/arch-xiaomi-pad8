[Unit]
Description=Start the ADSP and CDSP
DefaultDependencies=no
After=yupei-firmware.service yupei-pd-mapper.service yupei-audiopd.service yupei-sensorspd.service
Wants=yupei-pd-mapper.service yupei-audiopd.service yupei-sensorspd.service
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/yupei/start-dsps

[Install]
WantedBy=sysinit.target

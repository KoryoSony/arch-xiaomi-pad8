# Sourced by power-short and cover: panel power through mutter, which owns the
# display (org.gnome.Mutter.DisplayConfig PowerSaveMode: 0 = on, 3 = off).
panel_power() {
    case $1 in on) m=0 ;; *) m=3 ;; esac
    gdbus call --session --dest org.gnome.Mutter.DisplayConfig \
        --object-path /org/gnome/Mutter/DisplayConfig \
        --method org.freedesktop.DBus.Properties.Set \
        org.gnome.Mutter.DisplayConfig PowerSaveMode "<int32 $m>" >/dev/null
}

lock_and_blank() {
    # Lock through logind: GNOME Shell then locks at once, without the
    # slide-in animation that org.gnome.ScreenSaver.Lock plays. Then panel off.
    loginctl lock-session
    sleep 0.15
    panel_power off
}

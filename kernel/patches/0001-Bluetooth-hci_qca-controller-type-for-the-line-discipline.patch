--- a/drivers/bluetooth/hci_qca.c
+++ b/drivers/bluetooth/hci_qca.c
@@ -236,6 +236,46 @@ static int qca_power_off(struct hci_dev *hdev);
 static void qca_controller_memdump(struct work_struct *work);
 static void qca_dmp_hdr(struct hci_dev *hdev, struct sk_buff *skb);
 
+/* Controller type for the line discipline (btattach, no serdev node): on
+ * vendor device trees the UART has no "qcom,*-bt" serdev child (Android's
+ * stack drives it), so let userspace say what it is, e.g.
+ * hci_uart.qca_soc=wcn7850. Power is then handled outside this driver.
+ */
+static char *qca_soc;
+module_param(qca_soc, charp, 0644);
+MODULE_PARM_DESC(qca_soc, "QCA controller type without serdev: wcn3990, wcn6750, wcn6855, wcn7850 (default rome)");
+
+/* In-band sleep with the controller; off for controllers that don't wake
+ * (with btqca.nosleep=1, so the controller doesn't sleep either).
+ */
+static bool qca_ibs = true;
+module_param(qca_ibs, bool, 0644);
+MODULE_PARM_DESC(qca_ibs, "Use in-band sleep with the controller (default on)");
+
+/* On a command timeout the driver crashes the controller to collect a memory
+ * dump. On a combo chip (WCN7750: Wi-Fi + Bluetooth) that can take the whole
+ * system down; off means timeouts are only logged.
+ */
+static bool qca_memdump = true;
+module_param(qca_memdump, bool, 0644);
+MODULE_PARM_DESC(qca_memdump, "Crash the controller for a memory dump on command timeouts / hardware errors (default on)");
+
+static enum qca_btsoc_type qca_ldisc_soc_type(void)
+{
+	static const struct { const char *name; enum qca_btsoc_type type; } map[] = {
+		{ "wcn3988", QCA_WCN3988 }, { "wcn3990", QCA_WCN3990 },
+		{ "wcn3991", QCA_WCN3991 }, { "wcn3998", QCA_WCN3998 },
+		{ "wcn6750", QCA_WCN6750 }, { "wcn6855", QCA_WCN6855 },
+		{ "wcn7850", QCA_WCN7850 }, { "qca6390", QCA_QCA6390 },
+	};
+	int i;
+
+	for (i = 0; qca_soc && i < ARRAY_SIZE(map); i++)
+		if (sysfs_streq(qca_soc, map[i].name))
+			return map[i].type;
+	return QCA_ROME;
+}
+
 static enum qca_btsoc_type qca_soc_type(struct hci_uart *hu)
 {
 	enum qca_btsoc_type soc_type;
@@ -245,7 +285,7 @@ static enum qca_btsoc_type qca_soc_type(struct hci_uart *hu)
 
 		soc_type = qsd->btsoc_type;
 	} else {
-		soc_type = QCA_ROME;
+		soc_type = qca_ldisc_soc_type();
 	}
 
 	return soc_type;
@@ -1891,9 +1931,11 @@ static int qca_setup(struct hci_uart *hu)
 	case QCA_WCN6750:
 	case QCA_WCN6855:
 	case QCA_WCN7850:
-		qcadev = serdev_device_get_drvdata(hu->serdev);
-		if (qcadev->bdaddr_property_broken)
-			set_bit(HCI_QUIRK_BDADDR_PROPERTY_BROKEN, &hdev->quirks);
+		if (hu->serdev) {
+			qcadev = serdev_device_get_drvdata(hu->serdev);
+			if (qcadev->bdaddr_property_broken)
+				set_bit(HCI_QUIRK_BDADDR_PROPERTY_BROKEN, &hdev->quirks);
+		}
 
 		hci_set_aosp_capable(hdev);
 
@@ -1937,10 +1979,13 @@ static int qca_setup(struct hci_uart *hu)
 	ret = qca_uart_setup(hdev, qca_baudrate, soc_type, ver,
 			firmware_name);
 	if (!ret) {
-		clear_bit(QCA_IBS_DISABLED, &qca->flags);
+		if (qca_ibs)
+			clear_bit(QCA_IBS_DISABLED, &qca->flags);
 		qca_debugfs_init(hdev);
-		hu->hdev->hw_error = qca_hw_error;
-		hu->hdev->cmd_timeout = qca_cmd_timeout;
+		if (qca_memdump) {
+			hu->hdev->hw_error = qca_hw_error;
+			hu->hdev->cmd_timeout = qca_cmd_timeout;
+		}
 		if (hu->serdev) {
 			if (device_can_wakeup(hu->serdev->ctrl->dev.parent))
 				hu->hdev->wakeup = qca_wakeup;

# Sourced by power-short, power-long and cover (run as root by
# yupei-powerkey.service): act on the session that is on screen, whether it is
# a user's desktop, the login screen or GNOME Initial Setup.

# The active session on seat0: SID, its user (SUSER, SUID) and class.
SID=$(loginctl show-seat seat0 -p ActiveSession --value 2>/dev/null)
SUSER= SUID= SCLASS=
if [ -n "$SID" ]; then
    SUSER=$(loginctl show-session "$SID" -p Name --value)
    SUID=$(loginctl show-session "$SID" -p User --value)
    SCLASS=$(loginctl show-session "$SID" -p Class --value)
fi

# Run a command on that session's D-Bus session bus, as its user.
as_session() {
    [ -n "$SUID" ] && [ -S "/run/user/$SUID/bus" ] || return 1
    setpriv --reuid="$SUID" --regid="$(id -g "$SUSER")" --init-groups \
        env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$SUID/bus" \
            XDG_RUNTIME_DIR="/run/user/$SUID" "$@"
}

# Panel power through mutter, which owns the display
# (org.gnome.Mutter.DisplayConfig PowerSaveMode: 0 = on, 3 = off).
panel_power() {
    case $1 in on) m=0 ;; *) m=3 ;; esac
    as_session gdbus call --session --dest org.gnome.Mutter.DisplayConfig \
        --object-path /org/gnome/Mutter/DisplayConfig \
        --method org.freedesktop.DBus.Properties.Set \
        org.gnome.Mutter.DisplayConfig PowerSaveMode "<int32 $m>" >/dev/null
}

lock_and_blank() {
    # Lock through logind: GNOME Shell then locks at once, without the
    # slide-in animation that org.gnome.ScreenSaver.Lock plays. The login
    # screen and Initial Setup have nothing to lock: just switch off.
    case $SCLASS:$SUSER in
        user:gdm*|user:gnome-initial-setup) ;;   # Initial Setup runs as gdm-greeter
        user:*) loginctl lock-session "$SID"; sleep 0.15 ;;
    esac
    panel_power off
}

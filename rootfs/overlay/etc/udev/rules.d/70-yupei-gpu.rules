# Let the desktop user (group render, and whoever owns the active seat session,
# such as the GDM greeter) use the Adreno GPU through KGSL and the dma-buf heaps
# Mesa/Turnip allocate from; Android-style defaults are root-only.
KERNEL=="kgsl-3d0", GROUP="render", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="dma_heap", GROUP="render", MODE="0660", TAG+="uaccess"

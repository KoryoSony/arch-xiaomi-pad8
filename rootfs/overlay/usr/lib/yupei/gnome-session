#!/bin/sh
# GNOME Shell (headless) on the yupei panel via yupei-present-gnome. Runs in
# the foreground under yupei-desktop.service (as root, no login, for now).
# Software rendering until the GPU works.
# Not /run/user/0: systemd's user-runtime-dir@0 empties that whenever a root
# login session (e.g. SSH) ends, deleting GNOME's Wayland socket so that new
# apps fail with "Failed to open display".
export XDG_RUNTIME_DIR=/run/yupei-desktop
mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"

# Hand the display over from the boot log.
pkill -x yupei-bootlog && sleep 0.5

# --no-x11: libgvc's PulseAudio client otherwise connects to the on-demand
# Xwayland from GNOME's own main loop and deadlocks it.
# Mesa's shader cache must not keep llvmpipe code built before the CPU type
# was masked (SVE, see fix-cpuinfo): use a cache tied to this setup.
export MESA_SHADER_CACHE_DIR=/var/cache/yupei-mesa
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=GNOME
# Panel refresh: 30/48/50/60/90/120/144 Hz modes exist at 3200x2136.
export YUPEI_REFRESH=${YUPEI_REFRESH:-144}
# GPU: Mesa built by mesa/build-mesa.sh (Turnip on KGSL + Zink, Adreno 825)
# in /opt/mesa-yupei. `touch /etc/yupei/no-gpu` falls back to llvmpipe.
M=/opt/mesa-yupei
if [ -e $M/lib/libvulkan_freedreno.so ] && [ ! -e /etc/yupei/no-gpu ]; then
    export LD_LIBRARY_PATH=$M/lib
    export VK_ICD_FILENAMES=$M/share/vulkan/icd.d/freedreno_icd.aarch64.json
    export __EGL_VENDOR_LIBRARY_FILENAMES=$M/share/glvnd/egl_vendor.d/50_mesa.json
    export GBM_BACKENDS_PATH=$M/lib/gbm LIBGL_DRIVERS_PATH=$M/lib/dri
    export MESA_LOADER_DRIVER_OVERRIDE=zink
    echo "gnome-session: GPU rendering (zink on Turnip/KGSL)"
else
    export LIBGL_ALWAYS_SOFTWARE=1
    echo "gnome-session: software rendering (llvmpipe)"
fi
unset WAYLAND_DISPLAY DISPLAY
exec dbus-run-session -- sh -c '
    pipewire & sleep 1
    wireplumber &
    # The presenter starts before GNOME so that it, not mutter, holds DRM
    # master; it waits for GNOME on the bus, and exits if the cast is stopped
    # ("Stop" in the screen-sharing menu), so keep restarting it.
    ( while true; do
          yupei-present-gnome >> /var/log/yupei-present-gnome.log 2>&1
          sleep 1
      done ) &
    # WirePlumber does not link the video capture stream to mutter by itself
    # (target.object gets a serial where an id is expected): link by port name.
    ( while true; do
          pw-link gnome-shell:output_1 yupei-present-gnome:input_1 >/dev/null 2>&1
          sleep 2
      done ) &
    exec gnome-shell --headless --virtual-monitor 3200x2136@$YUPEI_REFRESH --no-x11
'

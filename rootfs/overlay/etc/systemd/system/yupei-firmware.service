[Unit]
Description=Mount Qualcomm firmware partitions
DefaultDependencies=no
After=local-fs-pre.target systemd-remount-fs.service
Before=systemd-modules-load.service sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/yupei/mount-firmware

[Install]
WantedBy=sysinit.target

#!/bin/sh
# Create the desktop user NAME: groups for GPU/display/input/audio and wheel
# (sudo with their own password, /etc/sudoers.d/10-wheel). Asks for the
# password: GDM logs users in with it, and there is no auto-login.
set -e
u=${1:?usage: setup-desktop-user NAME}
id "$u" >/dev/null 2>&1 || useradd -m -s /bin/bash "$u"
usermod -aG wheel,video,render,input,audio "$u"
passwd "$u"
echo "desktop user: $u ($(id "$u"))"

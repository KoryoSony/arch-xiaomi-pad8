#!/bin/bash
# Battery reporting fixes and over-discharge protection for the Xiaomi MCA
# charger/fuel-gauge drivers (percentage and voltage every 5 s):
#  - Percentage: MCA's displayed SOC (UISOC) is re-estimated from voltage at
#    boot, which reads high while charging (37% shown at a real 5%). Mirror the
#    fuel gauge's raw_soc (0.01 %) into strategy_fg/fake_soc, which MCA then
#    reports as the battery capacity.
#  - Charging sign: MCA reports a negative current_now while charging; UPower
#    then shows "discharging". Write a value whose sign follows the charger
#    status to $CUR, which upower.service sees in place of current_now (bind
#    mount, see its drop-in). Checked every second; when the status changes
#    (charger plugged/unplugged) UPower re-reads only on a uevent, which the
#    kernel sent before $CUR was right, so send it a fresh one.
#  - Over-discharge: nothing on Linux acted on MCA's critical level and the
#    battery once ran down to 2.5 V (Android stops at 3.25 V). Power off when
#    it stays below CUTOFF_MV for a minute.
# Battery life: this runs all the time, so it reads files with the shell's
# read builtin and sleeps on a FIFO read timeout: no process starts per tick.
FG=/sys/class/xm_power/fg_master
SFG=/sys/class/xm_power/fuelgauge/strategy_fg
BAT=/sys/class/power_supply/battery
CUR=/run/yupei/battery/current_now
CUTOFF_MV=${CUTOFF_MV:-3300}
WARN_MV=${WARN_MV:-3450}
mkdir -p "${CUR%/*}"
[ -e $CUR ] || echo 0 > $CUR
get() { read -r "$1" < "$2" 2>/dev/null; }      # get VAR FILE
rm -f /run/yupei/battery/tick; mkfifo /run/yupei/battery/tick
exec 9<> /run/yupei/battery/tick
nap() { read -r -t "$1" -u 9 _; }                 # sleep without a fork
low=0 warned=0 tick=0 last_status=
while :; do
    st= c=0
    get st $BAT/status
    get c $BAT/current_now
    c=${c#-}
    case $st in Charging) ;; *) c=-$c ;; esac
    echo $c > $CUR   # in place: the file is bind-mounted
    if [ "$st" != "$last_status" ]; then
        [ -n "$last_status" ] && udevadm trigger --action=change "$(readlink -f $BAT)" 2>/dev/null
        last_status=$st
    fi
    tick=$((tick + 1))
    [ $tick -lt 3 ] && { nap 2; continue; }
    tick=0

    raw= fake= mv= rsoc=
    get raw $SFG/raw_soc
    if [ -n "$raw" ] && [ "$raw" -ge 0 ]; then
        soc=$(( (raw + 50) / 100 ))
        [ $soc -gt 100 ] && soc=100
        [ "$st" = Full ] && soc=100
        get fake $SFG/fake_soc
        [ "$fake" = $soc ] || echo $soc > $SFG/fake_soc
    fi

    get mv $FG/vbatt || { nap 2; continue; }
    get rsoc $FG/rsoc
    if [ "$mv" -lt "$CUTOFF_MV" ] || { [ "$rsoc" = 0 ] && [ "$mv" -lt 3400 ]; }; then
        low=$((low + 1))
    else
        low=0
    fi
    if [ "$mv" -lt "$WARN_MV" ] && [ $warned = 0 ]; then
        warned=1
        echo "battery-guard: battery low (${mv} mV, ${rsoc}%), charge now"
        wall "Battery almost empty (${rsoc}%): connect a charger. The tablet will power off below ${CUTOFF_MV} mV." 2>/dev/null
    elif [ "$mv" -gt $((WARN_MV + 100)) ]; then
        warned=0
    fi
    if [ $low -ge 10 ]; then
        echo "battery-guard: ${mv} mV, ${rsoc}%: powering off to protect the battery"
        systemctl poweroff
        exit 0
    fi
    nap 2
done
